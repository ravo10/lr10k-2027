    family-names: Bjørk
  - given-names: Olaf Hallan
    family-names: Graven
  - given-names: Richard
    family-names: Thue
  - name: "University of South-Eastern Norway (USN)"
version: 2.0.0
date-released: 2026-11-07
license: MIT
repository-code: "https://github.com/ravo10/lr10k-2027"
keywords:
  - tensile testing
  - materials testing
  - Lloyd LR 10K
  - optical extensometer
  - stress-strain
